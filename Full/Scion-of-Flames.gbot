      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdLabel, Grimoire",
        "Name": "STOP"
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdBeep, Grimoire",
        "Times": 3
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdStopBotWithMessage, Grimoire",
        "Message": "Scion of Flames (Class) is in your inventory."
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdLabel, Grimoire",
        "Name": "STOP_MERGE"
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdBeep, Grimoire",
        "Times": 3
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdStopBotWithMessage, Grimoire",
        "Message": "Merge the missing pieces, buy Gold Voucher 100k for 100,000 gold each, then start the bot again. Flame of Maleno (Armor) at Forge Maleno: Black Flame of Maleno x75, Steel Ingot x50, Yew Ember x20, Gold Voucher 100k x15. Rank 6 Yew Mountains. Flame of Albedo (Armor) at Carcossa Canteen: Aiwass Diamond x50, White Flame of Albedo x150, Yew Ember x20, Gold Voucher 100k x15. Rank 7 Yew Mountains. Flame of Citrinitas (Armor) at Fort Luma Forge: Yellow Flame of Citrinitas x100, Yew Ember x20, Gold Voucher 100k x15. Rank 8 Yew Mountains. Flame of Rubedo (Armor) at WarwickForest Shop: Red Flame of Rubedo x100, Yew Ember x20, Gold Voucher 100k x15. Rank 9 Yew Mountains. Aleister's Champion Plate at Magnum Opus Shop: Flame of the Magnum Opus x40, Gold Voucher 100k x3. Aleister the Dawnseeker at Magnum Opus Shop: Aleister's Champion Plate, Flame of the Magnum Opus x20, Gold Voucher 100k x12. Rank 10 Yew Mountains."
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdLabel, Grimoire",
        "Name": "STOP_SIGIL"
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdBeep, Grimoire",
        "Times": 3
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdStopBotWithMessage, Grimoire",
        "Message": "Buy Flame Sigil for 0 AC from Pyromancer Sigils. High Adept Caustus in /join fireforge, or High Adept Thaumus in Battleon. Needs Pyromancer class in inventory and Rank 10 Embersea. Then start the bot again."
      },
      {
