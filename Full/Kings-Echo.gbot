      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdBeep, Grimoire",
        "Times": 3
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdStopBotWithMessage, Grimoire",
        "Message": "King's Echo is in your inventory."
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdLabel, Grimoire",
        "Name": "STOP_BUY_CLASS"
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdBeep, Grimoire",
        "Times": 3
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdStopBotWithMessage, Grimoire",
        "Message": "Turn in Echo of the King at Queen Victoria in /terminatemple, then buy King's Echo for 0 AC from Alteon's Gear."
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdLabel, Grimoire",
        "Name": "STOP_MACE"
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdBeep, Grimoire",
        "Times": 3
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdStopBotWithMessage, Grimoire",
        "Message": "Buy Alden's Mace for 0 AC. Click Alteon's Mace on Swordhaven Castle screen 15. Tell-Tale Heart must be done. Then start the bot again."
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdLabel, Grimoire",
        "Name": "STOP_MERGE"
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdBeep, Grimoire",
        "Times": 3
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdStopBotWithMessage, Grimoire",
        "Message": "Merge at Bocklin. Champion Lynaria Armor needs 80 Enthralling Gem Shard, Victorious' Golden Scale, and Gold Voucher 100k x8. Valen's Knightly Armor needs 60 Bocklin Ornament, Monster Blood, and Gold Voucher 100k x8. Alden's Liberation Armor needs 80 shards, 60 ornaments, 100 Thronekeeper's Rune, 20 King Alteon's Armor Fragment, both armors, and Gold Voucher 100k x20. Corrupted Light must be done. Then start the bot again."
      },
      {
        "$type": "Grimoire.Botting.Commands.Misc.CmdLabel, Grimoire",
